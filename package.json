{
  "name": "ezdash-backend",
  "version": "1.0.0",
  "description": "Backend API for Stock Monitoring Dashboard",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:migrate": "npx sequelize-cli db:migrate",
